@host = http://localhost:5276
@token = pegar-aca-el-token

POST {{host}}/api/users
Content-Type: application/json

{
  "restaurantName": "La Esquina",
  "password": "clave123",
  "firstName": "Máxima",
  "lastName": "Grima",
  "address": "Córdoba 1200, Rosario",
  "phoneNumber": "3415551234"
}

###

POST {{host}}/api/authentication/authenticate
Content-Type: application/json

{
  "restaurantName": "La Esquina",
  "password": "clave123"
}

###

POST {{host}}/api/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Pastas"
}

###

POST {{host}}/api/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Ravioles de ricota",
  "description": "Con salsa fileto",
  "price": 12800,
  "discount": 10,
  "hasHappyHour": false,
  "featured": true,
  "recommendedFor": 1,
  "categoryId": 1
}

###

GET {{host}}/api/products/me
Authorization: Bearer {{token}}

###

PUT {{host}}/api/products/1/happy-hour
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "hasHappyHour": true
}

###

GET {{host}}/api/users

###

GET {{host}}/api/users/1/categories

###

GET {{host}}/api/users/1/products

###

GET {{host}}/api/users/1/products?onPromotion=true

###

GET {{host}}/api/users/1/products?featured=true

###

